# MongoDB connection (operational database — read-only usage from this project)
MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE=winicari

# Additional databases discovered on the same MongoDB server.
# This project reads from all of them; none are created or owned by this project.
MONGODB_DB_OPERATIONAL=winicari
MONGODB_DB_TICKETS_ARCHIVE=Historique_Tickets
MONGODB_DB_POS_ARCHIVE=Historique_pos
MONGODB_DB_OPENDATA=OpenData

# Local paths for extracted/normalized datasets (see data/README.md)
DATA_RAW_DIR=./data/raw
DATA_PROCESSED_DIR=./data/processed
DATA_FEATURES_DIR=./data/features

REFERENCE_DB_PATH=../winicari/data/reference/winicari_reference_slim.db
